{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jeju-night:facility_change:v1",
  "type": "object",
  "properties": {
    "facility_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "streetlight",
        "cctv",
        "walkway",
        "other"
      ]
    },
    "before": {
      "enum": [
        "normal",
        "not_working",
        "flickering",
        "too_dark",
        "damaged",
        "obstructed",
        "other"
      ]
    },
    "after": {
      "enum": [
        "normal",
        "not_working",
        "flickering",
        "too_dark",
        "damaged",
        "obstructed",
        "other"
      ]
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "facility_id",
    "type",
    "before",
    "after",
    "report_id",
    "verified_by",
    "verified_at"
  ],
  "additionalProperties": false
}
