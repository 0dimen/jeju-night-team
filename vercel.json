{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/build_vercel_data.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{runtime/facilities/**,client/**,config/**,contracts/**,registry/**,data/route_examples/**,lexicon/**,data/population/**}",
      "excludeFiles": "{data/open/**,data/raw/**,.venv/**,tests/**,experiments/**,review/**,docs/**,*.pdf,*.zip,.git/**,**/*.env,**/.env*,**/*secrets*}"
    }
  },
  "regions": [
    "icn1"
  ]
}
