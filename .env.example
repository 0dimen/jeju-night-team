# 서버 환경변수 예시. 이 파일을 .env 로 복사해 값을 채운다. 실제 키는 Git 에 올리지 않는다.
# 장소·주소 검색과 배경지도 (VWorld 공간정보 오픈플랫폼 → 인증키 발급, 서비스 URL 에 실행 주소 등록)
VWORLD_API_KEY=
# VWorld 키에 등록한 도메인이 실행 주소와 다를 때만
VWORLD_DOMAIN=
# 보행 경로 (SK open API → TMAP 보행자 경로안내 상품 신청 후 appKey)
TMAP_APP_KEY=
# 선택: CCTV 원본을 새로 받는 수동 스크립트(scripts/fetch_public_cctv.py)에서만 사용
DATA_GO_KR_SERVICE_KEY=
